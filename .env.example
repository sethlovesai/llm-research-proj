# Variable names only. Copy to .env and fill in your own values. Never commit .env.
# Read by crm_sandbox/env/connect_sandbox.py (sf_auth); set the block for the org you use (B2C for this kit).

# LLM provider key (gpt-4o-mini via litellm)
OPENAI_API_KEY=

# org_type "b2c" (used by this kit)
SALESFORCE_B2C_USERNAME=
SALESFORCE_B2C_PASSWORD=
SALESFORCE_B2C_SECURITY_TOKEN=

# org_type "b2b"
SALESFORCE_B2B_USERNAME=
SALESFORCE_B2B_PASSWORD=
SALESFORCE_B2B_SECURITY_TOKEN=

# org_type "original" (CRMArena)
SALESFORCE_USERNAME=
SALESFORCE_PASSWORD=
SALESFORCE_SECURITY_TOKEN=
